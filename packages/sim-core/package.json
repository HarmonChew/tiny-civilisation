{
  "name": "@tiny-civ/sim-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest",
    "test:run": "vitest run --update=none",
    "test:coverage": "vitest run --coverage --update=none",
    "test:golden": "vitest run tests/golden-replays.test.ts --update=none",
    "test:golden:update": "vitest run tests/golden-replays.test.ts --update=all"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
